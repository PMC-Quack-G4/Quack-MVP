# Variables de entorno de servidor (sin prefijo VITE_ para no exponer secretos en el cliente)
# En Vercel, configúralas directamente con estos mismos nombres en Project Settings -> Environment Variables.

# Clave de API de Google Gemini (Google AI Studio)
# Si esta variable no se configura, la aplicación funcionará automáticamente en modo Mock local.
GEMINI_API_KEY=

# Identificador del modelo Gemini estándar (ej. gemini-flash-latest, gemini-3.1-flash-lite)
# Si no se especifica, por defecto se usará gemini-flash-latest.
GEMINI_MODEL=gemini-flash-latest

# Identificador del modelo Gemini Live (audio nativo bidireccional en tiempo real)
# Si no se especifica, por defecto se usará gemini-2.5-flash-native-audio-preview-12-2025.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Endpoint opcional (Formspree, Google Apps Script, webhook) para capturar prospectos de la landing
LEAD_ENDPOINT=

# ID de medición opcional de Google Analytics 4 (ej. G-XXXXXXX)
GA_MEASUREMENT_ID=
