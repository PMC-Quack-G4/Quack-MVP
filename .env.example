# Clave de API de Google Gemini (Free Tier de Google AI Studio)
# Obtén tu clave en: https://aistudio.google.com/app/apikey
# Si esta variable no se configura, la aplicación funcionará automáticamente en modo Mock local.
VITE_GEMINI_API_KEY=

# Identificador del modelo Gemini a utilizar (ej. gemini-flash-latest, gemini-3.8-flash, gemini-3.7-flash)
# Si no se especifica, por defecto se usará gemini-flash-latest.
VITE_GEMINI_MODEL=gemini-flash-latest
