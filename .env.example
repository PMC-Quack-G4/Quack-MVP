# Clave de API de Google Gemini (Free Tier de Google AI Studio)
# Obtén tu clave en: https://aistudio.google.com/app/apikey
# Si esta variable no se configura, la aplicación funcionará automáticamente en modo Mock local.
VITE_GEMINI_API_KEY=

# Identificador del modelo Gemini a utilizar (ej. gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
# Si no se especifica, por defecto se usará gemini-2.0-flash.
VITE_GEMINI_MODEL=gemini-2.0-flash
